{
  "name": "zcode-tarkov",
  "version": "0.2.0",
  "description": "Escape-from-Tarkov-inspired theme mode for the ZCode desktop client: fixed Tarkov palette, Monet dynamic color, and native passthrough, via CDP injection with a live settings panel.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "zcode-tarkov": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-client.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "test": "tsc -p tsconfig.test.json && node --test \"tests/**/*.test.mjs\"",
    "test:lifecycle": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-lifecycle.ps1",
    "package": "node scripts/package.mjs",
    "build:client": "node scripts/bundle-client.mjs"
  },
  "keywords": [
    "zcode",
    "zcode-plugin",
    "tarkov",
    "theme",
    "wallpaper",
    "material-design-3",
    "monet",
    "dynamic-color",
    "cdp",
    "bgm",
    "sfx",
    "audio",
    "electron",
    "pet"
  ],
  "files": [
    "dist",
    "commands",
    "skills",
    ".zcode-plugin",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "LICENSE"
  ],
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jimp": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
